# Environment Variables Example
# Copy this file to .env and fill in your values.
# The server validates all of these at startup and refuses to start (production) or warns (development)
# when something is wrong — see config/env.js.

# ── Required ────────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/online_food_ordering
NODE_ENV=development            # development | production | test  (anything else is rejected)

# Secret used to sign the session cookie. REQUIRED in production (>= 32 random characters, not a placeholder).
# In development, if this is missing or still the placeholder, a random secret is generated for each run
# (everyone is logged out on restart).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_strong_random_secret_here

# ── Optional ────────────────────────────────────────────────────────────────
# Other websites allowed to call this API from a browser (comma-separated origins). Default: none —
# the pages are served by this same server, so nothing else needs access.
# Also set this if a proxy rewrites the Host header (otherwise state-changing requests look cross-site).
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Number of reverse proxies in front of the app (nginx, Render, Heroku ...). Needed for correct client IPs
# (rate limiting) and for Secure cookies. Use the exact count, e.g. 1. Leave unset when there is no proxy.
# TRUST_PROXY=1

# Secure (HTTPS-only) session cookie. Defaults to true in production, false otherwise.
# Set to false only to try a production build on plain http://localhost.
# COOKIE_SECURE=true

# Login / API rate limiting is ON by default. Set to true only for local load testing.
# RATE_LIMIT_DISABLED=false

# One-click demo buttons on the login page (credentials come from `npm run seed`).
# Default: on in development, OFF in production. Set true to demo a production-mode build.
# ENABLE_DEMO_LOGIN=true

# `npm run seed` ERASES the whole database, so it refuses to run in production unless this is set.
# ALLOW_SEED_IN_PRODUCTION=true

# ── Online UPI QR payments (optional) ───────────────────────────────────────
# Leave UPI_ID empty and the checkout simply offers Cash on Delivery only.
# Use YOUR merchant UPI ID (placeholder below is NOT a real one). It is printed inside the QR code, so it is
# public by nature; never put a secret in these two variables.
# A business/merchant UPI ID is recommended: personal IDs ignore the order reference in the QR.
# UPI_ID=yourshop@yourbank
# UPI_PAYEE_NAME=FoodieHub
# Minutes a customer has to pay before the unpaid order is cancelled and the cart is restored (2-120, default 15).
# UPI_PAYMENT_WINDOW_MINUTES=15

# Secret shared with your payment provider (or your own bank-side script) for POST /api/payments/webhook.
# The webhook is DISABLED (answers 503) while this is empty. >= 32 random characters. Never commit the real value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYMENT_WEBHOOK_SECRET=
